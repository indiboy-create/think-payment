{
    "name": "youvision/think-payment",
    "description": "ThinkPHP 8 支付扩展包，基于 yansongda/pay，支持支付宝与微信支付。",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "think-payment",
        "pay",
        "alipay",
        "wechat"
    ],

    "authors": [
        {
            "name": "indiboy-create",
            "homepage": "https://github.com/indiboy-create"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "topthink/framework": "^8.0",
        "yansongda/pay": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkPayment\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Youvision\\ThinkPayment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkPayment\\Service"
            ],
            "config": {
                "payment": "config/payment.php"
            }
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}